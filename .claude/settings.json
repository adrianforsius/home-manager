{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(nix flake check:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix flake show:*)",
      "Bash(nix eval:*)",
      "Bash(nix search:*)",
      "Bash(nix build:* --dry-run)",
      "Bash(statix check:*)"
    ],
    "deny": [
      "Bash(nixos-rebuild switch:*)",
      "Bash(nixos-rebuild boot:*)",
      "Bash(nixos-rebuild test:*)",
      "Bash(darwin-rebuild switch:*)",
      "Bash(home-manager switch:*)",
      "Bash(make switch:*)",
      "Bash(make build-nix:*)",
      "Bash(sudo:*)"
    ]
  }
}
